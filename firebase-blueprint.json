{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in Nexora",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The unique Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "email": { "type": "string", "description": "User email address" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when the user account was created" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp when the user account was last updated" }
      },
      "required": ["userId", "email"]
    },
    "Dataset": {
      "title": "Dataset",
      "description": "Custom training dataset saved in cloud Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique dataset ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "name": { "type": "string", "description": "Dataset name" },
        "text": { "type": "string", "description": "Full dataset training text content" },
        "charCount": { "type": "integer", "description": "Character count of the dataset" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "userId", "name", "text", "charCount"]
    },
    "TrainingRun": {
      "title": "TrainingRun",
      "description": "History of neural training runs and loss metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Run identifier" },
        "userId": { "type": "string", "description": "User ID" },
        "datasetName": { "type": "string", "description": "Name of dataset trained on" },
        "hiddenSize": { "type": "integer", "description": "Hidden state dimension" },
        "seqLen": { "type": "integer", "description": "Sequence length" },
        "learningRate": { "type": "number", "description": "Learning rate used" },
        "targetEpochs": { "type": "integer", "description": "Target number of epochs" },
        "finalLoss": { "type": "number", "description": "Final loss achieved" },
        "totalSteps": { "type": "integer", "description": "Total steps completed" },
        "isNdkAccelerated": { "type": "boolean", "description": "Whether native C++ NDK was utilized" },
        "completedAt": { "type": "string", "format": "date-time", "description": "Completion timestamp" }
      },
      "required": ["id", "userId", "datasetName", "hiddenSize", "seqLen", "finalLoss"]
    },
    "CheckpointMetadata": {
      "title": "CheckpointMetadata",
      "description": "Metadata for saved model checkpoints stored in cloud",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Checkpoint identifier" },
        "userId": { "type": "string", "description": "User ID" },
        "name": { "type": "string", "description": "Checkpoint display name" },
        "parameterCount": { "type": "integer", "description": "Total parameter count" },
        "hiddenSize": { "type": "integer", "description": "Hidden dimension" },
        "vocabSize": { "type": "integer", "description": "Vocabulary size" },
        "checksumSha256": { "type": "string", "description": "SHA-256 weight checksum" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Saved timestamp" }
      },
      "required": ["id", "userId", "name", "parameterCount", "hiddenSize", "vocabSize"]
    },
    "ChatMessageRecord": {
      "title": "ChatMessageRecord",
      "description": "Synced chat conversation message",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message ID" },
        "userId": { "type": "string", "description": "User ID" },
        "sender": { "type": "string", "description": "USER, NEXORA, or SYSTEM" },
        "text": { "type": "string", "description": "Message content text" },
        "tokensGenerated": { "type": "integer", "description": "Tokens generated" },
        "latencyMs": { "type": "integer", "description": "Latency in milliseconds" },
        "tokensPerSec": { "type": "number", "description": "Tokens per second" },
        "timestamp": { "type": "integer", "description": "Unix timestamp in ms" }
      },
      "required": ["id", "userId", "sender", "text", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document"
    },
    "/users/{userId}/datasets/{datasetId}": {
      "schema": { "$ref": "#/entities/Dataset" },
      "description": "User custom training datasets"
    },
    "/users/{userId}/training_runs/{runId}": {
      "schema": { "$ref": "#/entities/TrainingRun" },
      "description": "User completed training runs and history"
    },
    "/users/{userId}/checkpoints/{checkpointId}": {
      "schema": { "$ref": "#/entities/CheckpointMetadata" },
      "description": "User model checkpoint metadata"
    },
    "/users/{userId}/chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessageRecord" },
      "description": "User chat messages history"
    }
  }
}
